---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Blog" description="Guides and tutorials for integrating Gmail OAuth into your applications.">
  <div class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-4 text-primary-900">Blog</h1>
    <p class="text-primary-600 mb-8">Guides and tutorials for adding Gmail to your app.</p>

    <div class="space-y-6">
      <a href="/blog/gmail-oauth-nodejs" class="block border border-primary-200 rounded-lg p-6 hover:border-primary-400 transition-colors">
        <h2 class="text-xl font-semibold text-primary-900 mb-2">Gmail OAuth in Node.js — The Easy Way</h2>
        <p class="text-primary-500 text-sm">Get Gmail access tokens with 3 API calls. No Google Cloud console required. Working code in under 5 minutes.</p>
      </a>
    </div>
  </div>
</Layout>
