---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Cursor — inbox.dog" description="Add Gmail to Cursor via MCP using Cursor's install link.">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <p class="text-sm text-primary-400 mb-2"><a href="/docs" class="hover:text-primary-600">&larr; Docs</a></p>
    <h1 class="text-4xl font-bold mb-4 text-primary-900">inbox.dog in Cursor</h1>
    <p class="text-primary-600 mb-8">Use <strong>Cursor's MCP install link</strong> for one-click setup. Get your API key at <a href="/connect" class="text-primary-900 underline">inbox.dog/connect</a>, then generate the link below.</p>

    <section class="mb-12 p-6 bg-primary-50 border border-primary-200 rounded-xl">
      <h2 class="text-lg font-semibold text-primary-900 mb-2">Official docs</h2>
      <p class="text-primary-600 text-sm mb-3">Cursor supports MCP via deeplinks. Format and generator:</p>
      <a href="https://cursor.com/docs/context/mcp/install-links" class="text-primary-900 font-medium underline">cursor.com/docs/context/mcp/install-links</a>
    </section>

    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4 text-primary-900">1. Get credentials</h2>
      <p class="text-primary-600 mb-4">Create an API key and connect Gmail at <a href="/connect" class="text-primary-900 underline">inbox.dog/connect</a>. You'll need the <strong>Client ID</strong> and <strong>Client Secret</strong>.</p>
    </section>

    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4 text-primary-900">2. Generate install link</h2>
      <p class="text-primary-600 mb-4">Paste your credentials below. We build the <code class="bg-primary-100 px-1 rounded font-mono">cursor://</code> link per <a href="https://cursor.com/docs/context/mcp/install-links" class="text-primary-900 underline">Cursor's spec</a>.</p>
      <div class="space-y-3 mb-4">
        <label class="block text-sm font-medium text-primary-700">Client ID</label>
        <input id="cursor-client-id" type="text" placeholder="id_..." class="w-full px-4 py-2 border border-primary-200 rounded-lg font-mono text-sm" />
        <label class="block text-sm font-medium text-primary-700">Client Secret</label>
        <input id="cursor-client-secret" type="password" placeholder="sk_..." class="w-full px-4 py-2 border border-primary-200 rounded-lg font-mono text-sm" />
      </div>
      <button id="cursor-generate" type="button" class="px-4 py-2 bg-primary-900 text-white rounded-lg text-sm font-medium hover:bg-primary-800">Generate install link</button>
      <div id="cursor-link-wrap" class="mt-4 hidden">
        <p class="text-sm text-primary-600 mb-2">Click to open in Cursor (or copy and paste into your browser):</p>
        <a id="cursor-link" href="#" class="block truncate text-primary-900 font-mono text-sm underline break-all"></a>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4 text-primary-900">3. Install in Cursor</h2>
      <p class="text-primary-600 mb-2">Click the generated link. Cursor will prompt to add the MCP server. Approve, then connect Gmail when the agent first uses Gmail tools.</p>
    </section>
  </div>

  <script>
    document.getElementById('cursor-generate')?.addEventListener('click', () => {
      const id = document.getElementById('cursor-client-id')?.value?.trim();
      const secret = document.getElementById('cursor-client-secret')?.value?.trim();
      const wrap = document.getElementById('cursor-link-wrap');
      const linkEl = document.getElementById('cursor-link');
      if (!id || !secret || !wrap || !linkEl) return;
      const config = { "inbox-dog": { "command": "npx", "args": ["-y", "inbox.dog", "mcp"], "env": { "INBOX_DOG_CLIENT_ID": id, "INBOX_DOG_CLIENT_SECRET": secret } } };
      const b64 = btoa(unescape(encodeURIComponent(JSON.stringify(config))));
      const url = `cursor://anysphere.cursor-deeplink/mcp/install?name=inbox-dog&config=${encodeURIComponent(b64)}`;
      linkEl.href = url;
      linkEl.textContent = url;
      wrap.classList.remove('hidden');
    });
  </script>
</Layout>
