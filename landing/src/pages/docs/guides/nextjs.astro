---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Add Gmail OAuth to Next.js">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <p class="text-sm text-primary-400 mb-2"><a href="/docs" class="hover:text-primary-600">&larr; Docs</a></p>
    <h1 class="text-4xl font-bold mb-4 text-primary-900">Add Gmail OAuth to a Next.js App</h1>
    <p class="text-primary-600 mb-12">Use inbox.dog to add Gmail authentication to your Next.js app with App Router. Two API routes and one button component.</p>

    <!-- Prerequisites -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4 text-primary-900">Prerequisites</h2>
      <ul class="list-disc list-inside text-primary-600 space-y-1">
        <li>A Next.js app with App Router (Next.js 13+)</li>
        <li>An inbox.dog API key (<a href="/docs/tutorial" class="text-primary-900 underline">get one here</a> if you don't have one)</li>
      </ul>
    </section>

    <!-- Environment variables -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4 text-primary-900">Add environment variables</h2>
      <p class="text-primary-600 mb-4">Create or update your <code class="bg-primary-100 px-1 rounded font-mono">.env.local</code> file:</p>
      <div class="bg-primary-900 rounded-lg p-4 text-sm overflow-x-auto mb-4">
        <pre class="text-primary-100 font-mono"><code class="language-bash">{`INBOX_DOG_CLIENT_ID=your_client_id
INBOX_DOG_CLIENT_SECRET=your_client_secret`}</code></pre>
      </div>
    </section>

    <!-- Step 1: Auth route -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4 text-primary-900">Create the auth route</h2>
      <p class="text-primary-600 mb-4">Create <code class="bg-primary-100 px-1 rounded font-mono">app/api/auth/gmail/route.ts</code>:</p>
      <div class="bg-primary-900 rounded-lg p-4 text-sm overflow-x-auto">
        <pre class="text-primary-100 font-mono"><code class="language-typescript">{`import { NextRequest } from 'next/server';

export async function GET(request: NextRequest) {
  const clientId = process.env.INBOX_DOG_CLIENT_ID;
  const redirectUri = \`\${request.nextUrl.origin}/api/auth/gmail/callback\`;

  const authUrl = new URL('https://inbox.dog/oauth/authorize');
  authUrl.searchParams.set('client_id', clientId!);
  authUrl.searchParams.set('redirect_uri', redirectUri);
  authUrl.searchParams.set('scope', 'email');

  return Response.redirect(authUrl.toString());
}`}</code></pre>
      </div>
    </section>

    <!-- Step 2: Callback route -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4 text-primary-900">Create the callback route</h2>
      <p class="text-primary-600 mb-4">Create <code class="bg-primary-100 px-1 rounded font-mono">app/api/auth/gmail/callback/route.ts</code>:</p>
      <div class="bg-primary-900 rounded-lg p-4 text-sm overflow-x-auto">
        <pre class="text-primary-100 font-mono"><code class="language-typescript">{`import { NextRequest } from 'next/server';

export async function GET(request: NextRequest) {
  const code = request.nextUrl.searchParams.get('code');

  if (!code) {
    return Response.redirect(new URL('/?error=no_code', request.url));
  }

  const response = await fetch('https://inbox.dog/oauth/token', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      code,
      client_id: process.env.INBOX_DOG_CLIENT_ID,
      client_secret: process.env.INBOX_DOG_CLIENT_SECRET,
    }),
  });

  const data = await response.json();

  if (!response.ok) {
    console.error('Token exchange failed:', data);
    return Response.redirect(new URL('/?error=token_exchange', request.url));
  }

  // Store tokens in your database or session here
  // data contains: { email, access_token, refresh_token, expires_in }

  // For now, redirect to a success page with the email
  return Response.redirect(
    new URL(\`/?success=true&email=\${encodeURIComponent(data.email)}\`, request.url)
  );
}`}</code></pre>
      </div>
    </section>

    <!-- Step 3: Add button -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4 text-primary-900">Add the "Connect Gmail" button</h2>
      <p class="text-primary-600 mb-4">In any client component:</p>
      <div class="bg-primary-900 rounded-lg p-4 text-sm overflow-x-auto">
        <pre class="text-primary-100 font-mono"><code class="language-typescript">{`'use client';

export function ConnectGmailButton() {
  return (
    <a
      href="/api/auth/gmail"
      className="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700"
    >
      Connect Gmail
    </a>
  );
}`}</code></pre>
      </div>
    </section>

    <!-- How it works -->
    <section class="mb-12 p-6 bg-primary-50 border border-primary-200 rounded-xl">
      <h2 class="text-lg font-semibold text-primary-900 mb-3">How it works</h2>
      <ol class="list-decimal list-inside text-primary-600 space-y-2 text-sm">
        <li>User clicks the button, which navigates to <code class="bg-primary-100 px-1 rounded font-mono">/api/auth/gmail</code></li>
        <li>The route redirects to inbox.dog with your <code class="bg-primary-100 px-1 rounded font-mono">client_id</code> and a callback URL</li>
        <li>inbox.dog handles the Google OAuth flow</li>
        <li>User is redirected back to <code class="bg-primary-100 px-1 rounded font-mono">/api/auth/gmail/callback</code> with a code</li>
        <li>Your callback route exchanges the code for tokens by calling <code class="bg-primary-100 px-1 rounded font-mono">inbox.dog/oauth/token</code></li>
        <li>Store the tokens in your database or session, then redirect the user</li>
      </ol>
    </section>

    <!-- Next steps -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4 text-primary-900">Next steps</h2>
      <ul class="space-y-3">
        <li><a href="/docs/guides/refresh" class="text-primary-900 underline hover:text-primary-600">Handle token refresh</a> — Access tokens expire after 1 hour</li>
        <li><a href="/docs/api" class="text-primary-900 underline hover:text-primary-600">API reference</a> — Full documentation of all endpoints</li>
      </ul>
    </section>
  </div>
</Layout>
