---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pricing">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-center mb-4">Simple Pricing</h1>
    <p class="text-xl text-gray-600 text-center mb-12">Pay only for what you use. No monthly fees.</p>

    <div class="max-w-md mx-auto bg-white rounded-lg shadow-lg overflow-hidden">
      <div class="bg-primary text-white p-6 text-center">
        <h2 class="text-2xl font-bold">Pay Per Use</h2>
        <div class="text-5xl font-bold mt-4">$0.10</div>
        <div class="text-blue-100">per OAuth flow</div>
      </div>
      <div class="p-6">
        <ul class="space-y-4">
          <li class="flex items-center">
            <svg class="w-5 h-5 text-green-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>10 free credits to start</span>
          </li>
          <li class="flex items-center">
            <svg class="w-5 h-5 text-green-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Unlimited API keys</span>
          </li>
          <li class="flex items-center">
            <svg class="w-5 h-5 text-green-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>Token refresh is free</span>
          </li>
          <li class="flex items-center">
            <svg class="w-5 h-5 text-green-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>All scopes included</span>
          </li>
          <li class="flex items-center">
            <svg class="w-5 h-5 text-green-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>No expiration on credits</span>
          </li>
        </ul>
        <a href="/docs" class="block mt-8 bg-primary text-white text-center py-3 rounded-lg font-medium hover:bg-secondary transition">
          Get Started Free
        </a>
      </div>
    </div>

    <div class="mt-12 text-center">
      <h3 class="text-xl font-semibold mb-4">Self-Host for Free</h3>
      <p class="text-gray-600 max-w-2xl mx-auto">
        inbox.dog is open source. Deploy to your own Cloudflare account and pay nothing.
        You'll need your own Google OAuth credentials.
      </p>
      <a href="https://github.com/inbox-dog/oauth" class="inline-block mt-4 text-primary hover:underline">
        View on GitHub →
      </a>
    </div>
  </div>
</Layout>
