---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'OAuth for email, simplified' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <title>{title} | inbox.dog</title>
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://inbox.dog" />
    <meta property="og:title" content={`${title} | inbox.dog`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://inbox.dog/meta.jpg" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://inbox.dog" />
    <meta name="twitter:title" content={`${title} | inbox.dog`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://inbox.dog/meta.jpg" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css" integrity="sha384-wH75j6z1lH97ZOpMOInqhgKzFkAInZPPSPlZpYKYTOqsaizPvhQZmAtLcPKXpLyH" crossorigin="anonymous">
  </head>
  <body class="bg-transparent text-primary-900 min-h-screen font-sans">
    <nav class="fixed top-0 left-0 right-0 z-50 bg-[#fafaf9]/80 backdrop-blur-md border-b border-primary-100">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 font-semibold text-primary-900 hover:opacity-70 transition-opacity">
          <img src="/logo.svg" alt="inbox.dog" class="h-7 w-auto" />
          <span class="tracking-tight">inbox.dog</span>
        </a>
        
        <!-- Desktop nav -->
        <div class="hidden md:flex items-center gap-8">
          <a href="/docs" class="text-sm font-medium text-primary-500 hover:text-primary-900 transition-colors">Docs</a>
          <a href="/pricing" class="text-sm font-medium text-primary-500 hover:text-primary-900 transition-colors">Pricing</a>
          <a href="/blog" class="text-sm font-medium text-primary-500 hover:text-primary-900 transition-colors">Blog</a>
          <a href="https://github.com/acoyfellow/inbox.dog" class="text-sm font-medium text-primary-500 hover:text-primary-900 transition-colors">GitHub</a>
          <a href="/demo" class="text-sm font-medium px-4 py-2 bg-primary-900 text-white rounded-full hover:bg-primary-800 transition-colors">Try Demo</a>
        </div>
        
        <!-- Mobile menu button -->
        <button id="mobile-menu-btn" class="md:hidden p-2 -mr-2 text-primary-600" aria-label="Toggle menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
      
      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-primary-100 bg-[#fafaf9]/95 backdrop-blur-md">
        <div class="px-4 py-4 space-y-3">
          <a href="/docs" class="block text-sm font-medium text-primary-600 hover:text-primary-900 py-2">Docs</a>
          <a href="/pricing" class="block text-sm font-medium text-primary-600 hover:text-primary-900 py-2">Pricing</a>
          <a href="/blog" class="block text-sm font-medium text-primary-600 hover:text-primary-900 py-2">Blog</a>
          <a href="https://github.com/acoyfellow/inbox.dog" class="block text-sm font-medium text-primary-600 hover:text-primary-900 py-2">GitHub</a>
          <a href="/demo" class="block text-sm font-medium px-4 py-3 bg-primary-900 text-white rounded-full text-center hover:bg-primary-800 transition-colors">Try Demo</a>
        </div>
      </div>
    </nav>
    
    <script is:inline>
      document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
        const menu = document.getElementById('mobile-menu');
        const icon = document.getElementById('menu-icon');
        menu?.classList.toggle('hidden');
        if (menu?.classList.contains('hidden')) {
          icon?.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
        } else {
          icon?.setAttribute('d', 'M6 18L18 6M6 6l12 12');
        }
      });
    </script>
    <div class="h-16"></div> <!-- Nav spacer -->
    <main>
      <slot />
    </main>
    <footer class="border-t border-primary-100 mt-20">
      <div class="max-w-6xl mx-auto px-6 py-12">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="flex items-center gap-2.5">
            <img src="/logo.svg" alt="inbox.dog" class="h-6 w-auto opacity-60" />
            <span class="text-sm text-primary-400">OAuth for email, simplified</span>
          </div>
          <div class="flex items-center gap-8 text-sm text-primary-400">
            <a href="/docs" class="hover:text-primary-600 transition-colors">Documentation</a>
            <a href="/pricing" class="hover:text-primary-600 transition-colors">Pricing</a>
            <a href="/blog" class="hover:text-primary-600 transition-colors">Blog</a>
            <a href="https://github.com/acoyfellow/inbox.dog" class="hover:text-primary-600 transition-colors">GitHub</a>
          </div>
        </div>
        <div class="mt-8 pt-8 border-t border-primary-100 text-center">
          <p class="text-xs text-primary-300">&copy; 2026 inbox.dog. Open source under MIT license.</p>
        </div>
      </div>
    </footer>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js" integrity="sha384-F/bZzf7p3Joyp5psL90p/p89AZJsndkSoGwRpXcZhleCWhd8SnRuoYo4d0yirjJp" crossorigin="anonymous"></script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        if (typeof hljs !== 'undefined') {
          hljs.highlightAll();
        }
      });
    </script>

    <!-- Cloudflare Web Analytics -->
    <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "d5a737cde1624a43acd89c948709a12d"}'></script>
  </body>
</html>
