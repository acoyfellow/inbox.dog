---
import {
  getSessionCookie,
  getSession,
  createClearCookieHeader,
  deleteSession,
} from "../lib/session";

export const prerender = false;

const { env } = Astro.locals.runtime ?? {};
const kv = env?.SESSIONS;
const sessionId = getSessionCookie(Astro.request);
const session = kv ? await getSession(kv, sessionId) : null;

if (!session) {
  return Astro.redirect("/");
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Chat - inbox.dog</title>
    <style>
      * { box-sizing: border-box; }
      body { font-family: system-ui, sans-serif; margin: 0; height: 100vh; display: flex; flex-direction: column; background: #0a0a0a; color: #fafafa; }
      header { display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1rem; border-bottom: 1px solid #27272a; }
      header h1 { font-size: 1rem; font-weight: 600; margin: 0; }
      header span { font-size: 0.85rem; color: #a1a1aa; }
      a.logout { font-size: 0.85rem; color: #a1a1aa; text-decoration: none; }
      a.logout:hover { color: #fafafa; }
      #messages { flex: 1; overflow-y: auto; padding: 1rem; display: flex; flex-direction: column; gap: 1rem; }
      .msg { max-width: 85%; padding: 0.75rem 1rem; border-radius: 0.75rem; font-size: 0.9rem; line-height: 1.5; }
      .msg.user { align-self: flex-end; background: #27272a; }
      .msg.assistant { align-self: flex-start; background: #18181b; border: 1px solid #27272a; }
      #form { display: flex; gap: 0.5rem; padding: 1rem; border-top: 1px solid #27272a; }
      #form input { flex: 1; padding: 0.75rem 1rem; border-radius: 0.5rem; border: 1px solid #27272a; background: #18181b; color: #fafafa; font-size: 0.9rem; }
      #form input:focus { outline: none; border-color: #3f3f46; }
      #form input::placeholder { color: #71717a; }
      #form button { padding: 0.75rem 1.25rem; border-radius: 0.5rem; background: #fafafa; color: #0a0a0a; border: none; font-weight: 500; cursor: pointer; }
      #form button:hover { background: #e4e4e7; }
      #form button:disabled { opacity: 0.5; cursor: not-allowed; }
    </style>
  </head>
  <body>
    <header>
      <h1>Gmail Chat</h1>
      <span>{session.email}</span>
      <a href="/logout" class="logout">Log out</a>
    </header>
    <div id="messages"></div>
    <form id="form">
      <input type="text" name="message" placeholder="Ask about your inbox..." autocomplete="off" />
      <button type="submit">Send</button>
    </form>
    <script>
      const form = document.getElementById("form");
      const input = form?.querySelector('input[name="message"]');
      const messages = document.getElementById("messages");

      function addMsg(role, text) {
        const div = document.createElement("div");
        div.className = `msg ${role}`;
        div.textContent = text;
        messages?.appendChild(div);
        messages?.scrollTo(0, messages.scrollHeight);
      }

      form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const text = input?.value?.trim();
        if (!text) return;
        input.value = "";
        addMsg("user", text);

        const btn = form.querySelector("button");
        btn.disabled = true;

        try {
          const res = await fetch("/api/chat", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ message: text }),
          });
          const data = await res.json();
          addMsg("assistant", data.reply ?? data.error ?? "Something went wrong.");
        } catch (err) {
          addMsg("assistant", "Failed to send message.");
        } finally {
          btn.disabled = false;
        }
      });
    </script>
  </body>
</html>
