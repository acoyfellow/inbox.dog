---
import { InboxDog } from "inbox.dog";
import {
  getSessionCookie,
  getSession,
  createSetCookieHeader,
} from "../lib/session";

export const prerender = false;

const clientId = import.meta.env.INBOX_DOG_CLIENT_ID;
const origin = Astro.url.origin;
const { env } = Astro.locals.runtime ?? {};
const kv = env?.SESSIONS;
const sessionId = getSessionCookie(Astro.request);
const session = kv ? await getSession(kv, sessionId) : null;

if (session) {
  return Astro.redirect("/chat");
}

const dog = new InboxDog();
const authUrl = dog.getAuthUrl({
  clientId,
  redirectUri: `${origin}/callback`,
  scope: "email:read",
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>inbox.dog Chat Example</title>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 480px; margin: 6rem auto; padding: 0 1rem; }
      h1 { font-size: 1.5rem; }
      p { color: #52525b; }
      a.btn { display: inline-block; background: #1a1a1a; color: white; padding: 0.75rem 1.5rem; border-radius: 0.5rem; text-decoration: none; margin-top: 1rem; }
      a.btn:hover { background: #333; }
    </style>
  </head>
  <body>
    <h1>Gmail Chat</h1>
    <p>Connect your Gmail to chat about your inbox.</p>
    <a href={authUrl} class="btn">Connect with Google</a>
  </body>
</html>
