---
import {
  getSessionCookie,
  deleteSession,
  createClearCookieHeader,
} from "../lib/session";

export const prerender = false;

const { env } = Astro.locals.runtime ?? {};
const kv = env?.SESSIONS;
const sessionId = getSessionCookie(Astro.request);

if (kv && sessionId) {
  await deleteSession(kv, sessionId);
}

return new Response(null, {
  status: 302,
  headers: {
    Location: "/",
    "Set-Cookie": createClearCookieHeader(),
  },
});
---
