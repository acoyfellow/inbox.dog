---
import "../styles/global.css";
import { getCookie } from "../lib/session";
import GmailChat from "../components/GmailChat";

export const prerender = false;
const userId = getCookie(Astro.request);
if (!userId) return Astro.redirect("/");
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Chat</title>
  </head>
  <body class="min-h-screen bg-neutral-950 text-neutral-100">
    <header class="flex items-center justify-between border-b border-neutral-800 px-4 py-3">
      <h1 class="text-base font-medium">Gmail Chat</h1>
      <a href="/logout" class="text-sm text-neutral-400 hover:text-neutral-300">Log out</a>
    </header>
    <GmailChat client:only="react" userId={decodeURIComponent(userId)} />
  </body>
</html>
